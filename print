template<typename T>
void print(const T &ct, const string &end = "\n", const string &sep = ", ", const string &bracket = "[]") {
    cout << ct << end;
}


template<>
void print(const bool &ct, const string &end, const string &sep, const string &bracket) {
    if (ct)
        cout << "true" << end;
    else
        cout << "false" << end;
}

template<typename T>
void print(const vector<T> &ct, const string &end = "\n", const string &sep = ", ", const string &bracket = "[]") {
    cout << bracket[0];
    auto next_it = ct.begin();
    next_it++;
    for (auto it = ct.begin(); it != ct.end(); it++, next_it++)
        if (next_it != ct.end()) {
            print(*it, "");
            cout << sep;
        } else {
            print(*it, "");
        }
    cout << bracket[1] << end;
}

