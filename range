template<typename T>
int len(T start, T stop) {
    int length = 0;
    for (auto it = start; it != stop; it++, length++);
    return length;
}

template<typename T>
int len(T t) {
    return t.size();
}

template<typename T = vector<int>>
T range(int stop) {
    T ct;
    for (int i = 0; i < stop; i++)
        ct.push_back(i);
    return ct;
}

template<typename T = vector<int>>
T range(int start, int stop) {
    T ct;
    for (int i = start; i < stop; i++)
        ct.push_back(i);
    return ct;
}

template<typename T = vector<int>>
T range(int start, int stop, int step) {
    T ct;
    if (step > 0)
        for (int i = start; i < stop; i += step)
            ct.push_back(i);
    else if (step < 0)
        for (int i = stop - 1; i >= start; i += step)
            ct.push_back(i);
    return ct;
}
